<?xml version="1.0" encoding="UTF-8"?>
<!-- The MFX Hub Java SDK: com.mfxhub:mfx-sdk, models generated by OpenAPI Generator at build, Java 21,
     Maven. A Core build is a preview, never published as a general SDK. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mfxhub</groupId>
  <artifactId>mfx-sdk</artifactId>
  <version>0.1.0</version>
  <name>MFX Hub SDK for Java</name>
  <description>The MFX Hub API: signed requests, typed errors, exact decimals, cursor paging and the stream.</description>
  <url>https://mfxhub.com</url>

  <!-- What Maven Central requires of every release, and shows of it: the licence, who develops it,
       and the public repository each release is published to. -->
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>KUDMANI PTY LTD</name>
    <url>https://mfxhub.com</url>
  </organization>
  <developers>
    <developer>
      <name>MFX Hub</name>
      <email>support@mfxhub.com</email>
      <organization>KUDMANI PTY LTD</organization>
      <organizationUrl>https://mfxhub.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/mfx-platform/mfx-sdk-java.git</connection>
    <developerConnection>scm:git:https://github.com/mfx-platform/mfx-sdk-java.git</developerConnection>
    <url>https://github.com/mfx-platform/mfx-sdk-java</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/mfx-platform/mfx-sdk-java/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-11-15T00:00:00Z</project.build.outputTimestamp>
    <jackson.version>2.23.0</jackson.version>
    <junit.version>6.1.3</junit.version>
    <openapi-generator.version>7.27.0</openapi-generator.version>
    <errorprone.version>2.53.0</errorprone.version>
    <!-- The unit run leaves the shared suite out; the suite's own job runs it alone with
         -Dgroups=conformance -DexcludedGroups=none (see .github/workflows/ci.yml). -->
    <excludedGroups>conformance</excludedGroups>
  </properties>

  <dependencies>
    <!-- JSON, which the generated models need. HTTP, the stream and Ed25519 are the JDK's own (J2). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <version>3.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.1</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The models, from the Python SDK's public cut of the contract (spec/openapi.yaml), written
           at every build into target/ by tools/GenerateModels.java, so there is nothing committed to
           drift. It runs OpenAPI Generator itself rather than through its Maven plugin, because the
           plugin's OpenAPI 3.1 parser dereferences every $ref first and the models then depend on
           the machine (the tool's Javadoc says how). The generator is this step's own dependency:
           nothing of it reaches the SDK's classpath. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <includeProjectDependencies>false</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <arguments>
                <argument>-classpath</argument>
                <classpath/>
                <argument>${project.basedir}/tools/GenerateModels.java</argument>
                <argument>${project.basedir}/spec/openapi.yaml</argument>
                <argument>${project.build.directory}/generated-sources/openapi</argument>
                <argument>${project.basedir}/tools/templates</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator</artifactId>
            <version>${openapi-generator.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <!-- No warnings (-Xlint:all -Werror), and Error Prone on the SDK's own code. The generated
             models are checked by javac alone. Error Prone needs the javac internals opened in
             .mvn/jvm.config. -->
        <configuration>
          <!-- Parameter names in the class files, so the surface check can read them. -->
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-sources/.*</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- The shared SDK test suite's runner lives in conformance/java:
           the vocabulary's operations in Java, nothing more. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>model-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>conformance-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>conformance/java</source>
                <!-- The SDK reference's generator (docs/sdkref.json), a javadoc doclet that SdkRefTest runs. -->
                <source>tools/sdkref/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The release: what Maven Central takes for a version, beside the jar and this POM. A sources
         jar (the generated models included) and a Javadoc jar, every file signed with GPG, and the
         upload to the Central Portal. The public repository's release workflow runs
         `./mvnw -P release deploy` with the signing key and the Portal token from its `maven-central`
         environment. Without a key, `-Dgpg.skip` builds everything but the signatures, as CI does on
         every pull request; nothing is uploaded short of `deploy`. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <quiet>true</quiet>
              <!-- The generated models document what the API description says and no more, so a
                   missing comment is not an error; every other Javadoc check is. -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <!-- Bouncy Castle signs in-process from MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE: no gpg
                   binary, agent or keyring on the runner, and the key never touches its disk. -->
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- The server in settings.xml that holds the Portal user token. -->
              <publishingServerId>central</publishingServerId>
              <!-- The approval is the release workflow's environment; once past it, the version is
                   validated and published, and the job waits until Central says it is. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
